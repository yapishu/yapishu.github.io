---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Reid Scoggin — Generalist symbol manipulator">
  <main class="homepage">
    <div class="site-shell">
      <div class="rule rule-top" aria-hidden="true"></div>

      <header class="hero-card">
        <img src="/images/reid-header.png" alt="Generalist symbol manipulator. Reid Scoggin, Austin, Texas, USA." />
      </header>

      <nav class="links" aria-label="Elsewhere online">
        <a class="link-item" href="https://github.com/yapishu" target="_blank" rel="noreferrer">
          <span class="link-icon" aria-hidden="true">GH</span>
          <span>GitHub</span>
        </a>
        <a class="link-item" href="https://x.com/sitful_hatred" target="_blank" rel="noreferrer">
          <span class="link-icon" aria-hidden="true">X</span>
          <span>X</span>
        </a>
        <a class="link-item" href="https://nativeplanet.io" target="_blank" rel="noreferrer">
          <span class="link-icon" aria-hidden="true">NP</span>
          <span>NativePlanet.io</span>
	</a>
	<a class="link-item" href="https://signal.me/#eu/BuSSkzJuRyEVa5dHYjsdPw5XGDywQegvrTONicRoopYezYvf4JZNU6xkpnQZNUZ9" target="_blank" rel="noreferrer">
          <span class="link-icon" aria-hidden="true">S</span>
	  <span>Signal</span>
	</a>
        <div class="link-item">
          <span class="link-icon" aria-hidden="true">~</span>
          <span>~sitful-hatred</span>
        </div>
      </nav>

      <div class="rule rule-bottom" aria-hidden="true"></div>
      <footer class="media-notice">
        <img src="/images/motizuki-media-notice.gif" alt="Media-use notice" />
      </footer>
    </div>
  </main>
</Layout>
